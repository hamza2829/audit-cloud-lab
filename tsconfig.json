{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@ai/*": ["ai/src/*"],
      "@/*": ["web/src/*"]
    }
  },
  "include": ["shared", "ai/src", "web/src", "web/vite.config.ts", "functions/src", "seed", "tests", "e2e", "playwright.config.ts", "vitest.config.ts", "vitest.rules.config.ts"]
}
